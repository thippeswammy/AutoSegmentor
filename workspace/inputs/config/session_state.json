{
  "external_libs": [
    "external/segment_anything_2",
    "external/segment_anything_2/sam2",
    "external/co-tracker"
  ],
  "video_inputs": {
    "template": "./workspace/VideoInputs/Video{}.mp4",
    "start": 6,
    "end": 1,
    "max_frames": 10
  },
  "video_outputs": {
    "final_path": "./workspace/outputs",
    "working_dir": "./workspace/working_dir",
    "prefix": "Img",
    "delete_after": "yes"
  },
  "pipeline": {
    "run_mode": "all",
    "batch_size": 30,
    "fps": 23,
    "review_from_start": false,
    "auto_prompt": true
  },
  "models": {
    "sam": {
      "enabled": true,
      "checkpoint": "external/segment_anything_2/checkpoints/sam2_hiera_large.pt",
      "model_config": "sam2_hiera_l.yaml"
    },
    "pose": {
      "enabled": true,
      "tracker": "cotracker",
      "radius": 5,
      "classes": [
        {
          "class_id": 1,
          "object_id": 1,
          "keypoints": [
            "p1",
            "p2",
            "p3",
            "p4"
          ]
        }
      ],
      "cotracker": {
        "checkpoint": "external/co-tracker/checkpoints/scaled_offline.pth",
        "window_len": 60
      }
    }
  }
}