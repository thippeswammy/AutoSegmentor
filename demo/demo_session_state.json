{
  "demo": {
    "name": "cat",
    "description": "Classic segmentation/pose demo using the bundled cat video.",
    "license": "Project asset"
  },
  "external_libs": [
    "external/segment_anything_2",
    "external/segment_anything_2/sam2",
    "external/co-tracker"
  ],
  "video_inputs": {
    "template": "demo/videos/cat.mp4",
    "start": 1,
    "end": 1,
    "max_frames": 0
  },
  "video_outputs": {
    "final_path": "demo",
    "working_dir": "demo/working_dir",
    "prefix": "cat_demo",
    "delete_after": "yes"
  },
  "pipeline": {
    "run_mode": "all",
    "batch_size": 30,
    "fps": 30,
    "review_from_start": false,
    "auto_prompt": true
  },
  "models": {
    "sam": {
      "enabled": true,
      "checkpoint": "external/segment_anything_2/checkpoints/sam2_hiera_large.pt",
      "model_config": "sam2_hiera_l.yaml"
    },
    "pose": {
      "enabled": true,
      "tracker": "cotracker",
      "radius": 2,
      "classes": [
        {
          "class_id": 1,
          "num_keypoints": 6,
          "keypoints": [
            "p1",
            "p2",
            "p3",
            "p4",
            "p5"
          ]
        }
      ],
      "cotracker": {
        "checkpoint": "external/co-tracker/checkpoints/scaled_offline.pth",
        "window_len": 60
      }
    }
  }
}