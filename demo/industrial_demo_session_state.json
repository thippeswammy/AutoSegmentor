{
  "demo": {
    "name": "industrial-warehouse",
    "description": "Material handling auto-labeling demo: detect/track pallets and forklift in warehouse footage using SAM2 + CoTracker3.",
    "license": "Pexels License (free to use)"
  },
  "external_libs": [
    "external/segment_anything_2",
    "external/segment_anything_2/sam2",
    "external/co-tracker"
  ],
  "video_inputs": {
    "template": "demo/videos/forklift_pallets_warehouse.mp4",
    "start": 1,
    "end": 1,
    "max_frames": 0
  },
  "video_outputs": {
    "final_path": "demo",
    "working_dir": "demo/working_dir",
    "prefix": "industrial_pallet",
    "delete_after": "yes"
  },
  "pipeline": {
    "run_mode": "all",
    "batch_size": 30,
    "fps": 30,
    "review_from_start": false,
    "auto_prompt": true
  },
  "models": {
    "sam": {
      "enabled": true,
      "checkpoint": "external/segment_anything_2/checkpoints/sam2_hiera_large.pt",
      "model_config": "sam2_hiera_l.yaml"
    },
    "pose": {
      "enabled": true,
      "tracker": "cotracker",
      "radius": 2,
      "classes": [
        {
          "class_id": 1,
          "num_keypoints": 6,
          "keypoints": [
            "pallet_corner_1",
            "pallet_corner_2",
            "pallet_corner_3",
            "pallet_corner_4",
            "pallet_center",
            "pallet_top_center"
          ]
        },
        {
          "class_id": 2,
          "num_keypoints": 3,
          "keypoints": [
            "forklift_forks",
            "forklift_mast",
            "forklift_top"
          ]
        }
      ],
      "cotracker": {
        "checkpoint": "external/co-tracker/checkpoints/scaled_offline.pth",
        "window_len": 60
      }
    }
  },
  "interaction": {
    "active_target_models": ["sam", "pose"],
    "auto_shift_enabled": true
  }
}
