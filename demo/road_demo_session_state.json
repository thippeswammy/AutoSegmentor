{
  "demo": {
    "name": "road",
    "description": "SAM2 segmentation-only demo on the bundled dashcam road video (no CoTracker pose tracking).",
    "license": "Project asset"
  },
  "external_libs": [
    "external/segment_anything_2",
    "external/segment_anything_2/sam2",
    "external/co-tracker"
  ],
  "video_inputs": {
    "template": "demo/videos/road_dashboard.mp4",
    "start": 1,
    "end": 1,
    "max_frames": 0
  },
  "video_outputs": {
    "final_path": "demo",
    "working_dir": "demo/working_dir",
    "prefix": "road_demo",
    "delete_after": "yes"
  },
  "pipeline": {
    "run_mode": "all",
    "batch_size": 30,
    "fps": 30,
    "review_from_start": false,
    "auto_prompt": true
  },
  "models": {
    "sam": {
      "enabled": true,
      "checkpoint": "external/segment_anything_2/checkpoints/sam2_hiera_large.pt",
      "model_config": "sam2_hiera_l.yaml"
    },
    "pose": {
      "enabled": false
    }
  }
}
