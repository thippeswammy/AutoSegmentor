{
  "demo": {
    "name": "pallet-closeup",
    "description": "Label your own pallet object: close-up of a wooden pallet stack for pallet detection/pose labeling (create your own labels).",
    "license": "Pixabay Content License"
  },
  "external_libs": [
    "external/segment_anything_2",
    "external/segment_anything_2/sam2",
    "external/co-tracker"
  ],
  "video_inputs": {
    "template": "demo/videos/pallet_stack_closeup.mp4",
    "start": 1,
    "end": 1,
    "max_frames": 0
  },
  "video_outputs": {
    "final_path": "demo",
    "working_dir": "demo/working_dir",
    "prefix": "pallet_closeup",
    "delete_after": "yes"
  },
  "pipeline": {
    "run_mode": "all",
    "batch_size": 30,
    "fps": 30,
    "review_from_start": false,
    "auto_prompt": true
  },
  "models": {
    "sam": {
      "enabled": true,
      "checkpoint": "external/segment_anything_2/checkpoints/sam2_hiera_large.pt",
      "model_config": "sam2_hiera_l.yaml"
    },
    "pose": {
      "enabled": true,
      "tracker": "cotracker",
      "radius": 2,
      "classes": [
        {
          "class_id": 1,
          "num_keypoints": 4,
          "keypoints": [
            "pallet_corner_1",
            "pallet_corner_2",
            "pallet_corner_3",
            "pallet_corner_4"
          ]
        }
      ],
      "cotracker": {
        "checkpoint": "external/co-tracker/checkpoints/scaled_offline.pth",
        "window_len": 60
      }
    }
  },
  "interaction": {
    "active_target_models": ["sam", "pose"],
    "auto_shift_enabled": true
  }
}
